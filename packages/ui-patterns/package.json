{
  "name": "@microbit/ui-patterns",
  "version": "0.0.0",
  "description": "Higher-level UI patterns composed from @microbit/ui primitives. Ships as source; see README for the consumption setup.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./messages": "./src/messages.ts",
    "./lang/*": "./lang/*"
  },
  "files": [
    "src",
    "lang",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "panda": "panda codegen",
    "typecheck": "npm run panda && tsc --noEmit",
    "pretest": "npm run panda",
    "test": "vitest run"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.0"
  },
  "peerDependencies": {
    "@microbit/ui": "^0.3.0",
    "@pandacss/dev": "^1.11.4",
    "react": "^18.3.1",
    "react-icons": "^4.12.0 || ^5.0.0",
    "react-intl": "^6.6.8 || ^7.0.0"
  },
  "devDependencies": {
    "@microbit/ui": "*",
    "@pandacss/dev": "^1.11.4",
    "@storybook/react-vite": "^10.5.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-aria": "^3.50.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^18.3.1",
    "react-icons": "^4.12.0",
    "react-intl": "^6.6.8",
    "typescript": "^5.4.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
