{
  "name": "@microbit/i18n-tools",
  "version": "0.0.0",
  "description": "Crowdin and react-intl catalog tooling shared by the micro:bit web apps: tidy and compile message catalogs, and upload, download and report on their translations.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "microbit-i18n": "./bin/microbit-i18n.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@crowdin/crowdin-api-client": "^1.56.4",
    "@formatjs/icu-messageformat-parser": "^2.9.4",
    "fflate": "^0.8.3"
  }
}
