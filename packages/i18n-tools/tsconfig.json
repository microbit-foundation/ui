{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* A Node CLI, run from TypeScript source by Node's type stripping: only
       erasable syntax, explicit .ts import specifiers, type-only imports. */
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
