{
  "name": "microbit-ui-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "storybook": "npm run storybook -w @microbit/ui-storybook",
    "build-storybook": "npm run build-storybook -w @microbit/ui-storybook",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build-storybook",
    "update-translations": "node bin/update-translations.cjs",
    "i18n:tidy": "node bin/tidy-lang.cjs",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "prettier": "3.3.2",
    "eslint": "^9.39.5",
    "@microbit/eslint-config": "^0.1.0"
  },
  "overrides": {
    "postcss": "^8.5.26"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
