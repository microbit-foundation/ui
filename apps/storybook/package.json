{
  "name": "@microbit/ui-storybook",
  "private": true,
  "version": "0.0.0",
  "description": "Storybook harness for the packages in this repo. Never published.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "panda": "panda codegen",
    "typecheck": "npm run panda && tsc --noEmit",
    "prestorybook": "npm run panda",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:python": "UI_PRESET_STACK=python npm run storybook",
    "storybook:createai": "UI_PRESET_STACK=createai npm run storybook",
    "storybook:classroom": "UI_PRESET_STACK=classroom npm run storybook",
    "storybook:data": "UI_PRESET_STACK=data npm run storybook",
    "prebuild-storybook": "npm run panda",
    "build-storybook": "storybook build",
    "pretest": "npm run panda",
    "test": "vitest run"
  },
  "devDependencies": {
    "@microbit/ui": "*",
    "@microbit/ui-carousel": "*",
    "@microbit/ui-code-view": "*",
    "@microbit/ui-patterns": "*",
    "@pandacss/dev": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "react": "^18.3.1",
    "react-aria": "^3.50.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^18.3.1",
    "react-icons": "^4.12.0",
    "react-intl": "^12.1.5",
    "storybook": "^10.6.3",
    "swiper": "^14.0.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.5"
  }
}
