{
  "name": "@microbit/ui-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "panda": "panda codegen && panda cssgen --outfile src/styled-system.css",
    "panda:watch": "panda cssgen --watch --outfile src/styled-system.css",
    "predev": "npm run panda",
    "dev": "vite",
    "prebuild": "npm run panda",
    "build": "tsc --noEmit && vite build",
    "typecheck": "npm run panda && tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@microbit/ui": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-aria-components": "^1.19.0",
    "react-icons": "^4.12.0",
    "react-intl": "^6.6.8"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.4.2",
    "vite": "^6.3.5"
  }
}
